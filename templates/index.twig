            <form onsubmit="handleAppSubmission(event)" class="space-y-4 text-xs">
                <div>
                    <label class="block text-slate-300 font-semibold mb-1">App / Product Name *</label>
                    <input type="text" required placeholder="e.g. CodePulse AI" class="w-full bg-slate-900 text-white p-3 rounded-xl border border-slate-700 focus:border-brand-500 focus:outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Category *</label>
                        <select required class="w-full bg-slate-900 text-white p-3 rounded-xl border border-slate-700 focus:outline-none">
                            <option value="ai">AI &amp; Machine Learning</option>
                            <option value="productivity">Productivity</option>
                            <option value="developer">Developer Tools</option>
                            <option value="design">Design &amp; Creative</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Pricing Model *</label>
                        <select required class="w-full bg-slate-900 text-white p-3 rounded-xl border border-slate-700 focus:outline-none">
                            <option value="Free">Free</option>
                            <option value="Freemium">Freemium</option>
                            <option value="Paid">Paid</option>
                            <option value="Open Source">Open Source</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-slate-300 font-semibold mb-1">Website URL *</label>
                    <input type="url" required placeholder="https://myapp.com" class="w-full bg-slate-900 text-white p-3 rounded-xl border border-slate-700 focus:border-brand-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-slate-300 font-semibold mb-1">Short Tagline *</label>
                    <input type="text" required placeholder="One sentence pitch..." class="w-full bg-slate-900 text-white p-3 rounded-xl border border-slate-700 focus:border-brand-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-slate-300 font-semibold mb-1">Detailed Description</label>
                    <textarea rows="3" placeholder="Describe key benefits and capabilities..." class="w-full bg-slate-900 text-white p-3 rounded-xl border border-slate-700 focus:border-brand-500 focus:outline-none"></textarea>
                </div>

                <div class="pt-2 flex justify-end gap-3">
                    <button type="button" onclick="closeSubmitModal()" class="px-4 py-2.5 rounded-xl bg-slate-800 text-slate-300 font-semibold">Cancel</button>
                    <button type="submit" class="px-6 py-2.5 rounded-xl gradient-bg text-white font-bold shadow-lg shadow-brand-500/20">Submit Application</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== SAVED APPS MODAL ==================== -->
    <div id="savedModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden">
        <div class="glass-panel w-full max-w-md rounded-3xl border border-slate-700 shadow-2xl p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <h3 class="text-lg font-extrabold text-white flex items-center gap-2">
                    <i class="fa-solid fa-bookmark text-amber-400"></i> Saved Applications
                </h3>
                <button onclick="closeSavedModal()" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <div id="savedListContainer" class="space-y-3 max-h-80 overflow-y-auto text-xs">
                <!-- Dynamically populated -->
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white text-xs font-bold px-4 py-3 rounded-xl border border-brand-500 shadow-2xl flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300">
        <i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
        <span id="toastMsg">Action completed</span>
    </div>

    <!-- ==================== JAVASCRIPT LOGIC ==================== -->
    <script>
        // Store pre-rendered Twig apps dataset into JS array for modal and client interactivity
        const APPS_DATA = {{ apps|json_encode|raw }};
        let currentCategory = 'all';
        let currentPricing = 'all';
        let searchQuery = '';
        let savedAppIds = JSON.parse(localStorage.getItem('appvault_saved') || '[]');

        document.addEventListener('DOMContentLoaded', () => {
            updateSavedBadge();
        });

        // Sync header and hero search inputs
        function syncAndFilter(val) {
            searchQuery = val.toLowerCase().trim();
            document.getElementById('headerSearchInput').value = val;
            document.getElementById('heroSearchInput').value = val;
            filterApps();
        }

        function setSearchTag(tag) {
            syncAndFilter(tag);
            document.getElementById('explore-apps').scrollIntoView({ behavior: 'smooth' });
        }

        function clearSearch() {
            syncAndFilter('');
            document.getElementById('pricingFilter').value = 'all';
            currentPricing = 'all';
            selectCategory('all');
        }

        // Category selection
        function selectCategory(catId) {
            currentCategory = catId;
            document.querySelectorAll('.cat-tab').forEach(tab => {
                tab.classList.remove('bg-brand-600', 'text-white', 'shadow-lg', 'shadow-brand-600/30');
                tab.classList.add('bg-slate-800/60', 'text-slate-300', 'border-slate-800');
            });

            const activeTab = document.getElementById(`cat-tab-${catId}`);
            if (activeTab) {
                activeTab.classList.remove('bg-slate-800/60', 'text-slate-300', 'border-slate-800');
                activeTab.classList.add('bg-brand-600', 'text-white', 'shadow-lg', 'shadow-brand-600/30');
            }

            filterApps();
        }

        // Filter Grid Logic
        function filterApps() {
            currentPricing = document.getElementById('pricingFilter').value;
            const cards = document.querySelectorAll('.app-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const name = card.getAttribute('data-name').toLowerCase();
                const cat = card.getAttribute('data-category');
                const pricing = card.getAttribute('data-pricing');
                
                const matchesCategory = (currentCategory === 'all' || cat === currentCategory);
                const matchesPricing = (currentPricing === 'all' || pricing === currentPricing);
                const matchesSearch = (name.includes(searchQuery) || cat.includes(searchQuery) || pricing.toLowerCase().includes(searchQuery));

                if (matchesCategory && matchesPricing && matchesSearch) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            const emptyState = document.getElementById('noResultsState');
            if (visibleCount === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }
        }

        // Sort Grid Logic
        function sortApps() {
            const sortBy = document.getElementById('sortSelect').value;
            const grid = document.getElementById('appsGrid');
            const cards = Array.from(grid.querySelectorAll('.app-card'));

            cards.sort((a, b) => {
                if (sortBy === 'upvotes') {
                    return parseInt(b.getAttribute('data-upvotes')) - parseInt(a.getAttribute('data-upvotes'));
                } else if (sortBy === 'rating') {
                    return parseFloat(b.getAttribute('data-rating')) - parseFloat(a.getAttribute('data-rating'));
                } else if (sortBy === 'name') {
                    return a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
                } else {
                    return parseInt(b.getAttribute('data-id')) - parseInt(a.getAttribute('data-id'));
                }
            });

            cards.forEach(card => grid.appendChild(card));
        }

        // Upvote functionality
        function upvoteApp(id, btn) {
            const voteSpan = btn.querySelector('.vote-count');
            let votes = parseInt(voteSpan.innerText);
            
            if (btn.classList.contains('voted')) {
                votes -= 1;
                btn.classList.remove('voted', 'bg-brand-600', 'text-white');
                btn.classList.add('bg-slate-800', 'text-slate-200');
                showToast('Upvote removed');
            } else {
                votes += 1;
                btn.classList.add('voted', 'bg-brand-600', 'text-white');
                btn.classList.remove('bg-slate-800', 'text-slate-200');
                showToast('Upvoted successfully! 🔥');
            }
            voteSpan.innerText = votes;
            btn.closest('.app-card').setAttribute('data-upvotes', votes);
        }

        function upvoteSpotlight(btn) {
            const voteSpan = document.getElementById('spotlightVoteCount');
            let votes = parseInt(voteSpan.innerText);
            if (btn.classList.contains('voted')) {
                votes -= 1;
                btn.classList.remove('voted');
                showToast('Upvote removed');
            } else {
                votes += 1;
                btn.classList.add('voted');
                showToast('Spotlight App Upvoted! 🔥');
            }
            voteSpan.innerText = votes;
        }

        // Bookmark functionality
        function toggleBookmark(id, btn) {
            const icon = btn.querySelector('i');
            if (savedAppIds.includes(id)) {
                savedAppIds = savedAppIds.filter(item => item !== id);
                icon.classList.replace('fa-solid', 'fa-regular');
                btn.classList.remove('text-amber-400');
                showToast('Removed from saved apps');
            } else {
                savedAppIds.push(id);
                icon.classList.replace('fa-regular', 'fa-solid');
                btn.classList.add('text-amber-400');
                showToast('App saved to your bookmarks!');
            }
            localStorage.setItem('appvault_saved', JSON.stringify(savedAppIds));
            updateSavedBadge();
        }

        function updateSavedBadge() {
            const badge = document.getElementById('savedCountBadge');
            if (savedAppIds.length > 0) {
                badge.innerText = savedAppIds.length;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        // Open App Detail Modal
        function openAppModal(id) {
            const app = APPS_DATA.find(a => a.id === id);
            if (!app) return;

            document.getElementById('modalAppLogo').src = app.logo;
            document.getElementById('modalAppName').innerText = app.name;
            document.getElementById('modalAppCategory').innerText = app.category_name;
            document.getElementById('modalAppScreenshot').src = app.screenshot;
            document.getElementById('modalAppPricing').innerText = app.pricing;
            document.getElementById('modalAppTagline').innerText = app.tagline;
            document.getElementById('modalAppDescription').innerText = app.long_description || app.description;
            document.getElementById('modalMakerAvatar').src = app.maker_avatar;
            document.getElementById('modalMakerName').innerText = app.maker_name;
            document.getElementById('modalMakerTitle').innerText = app.maker_title;
            document.getElementById('modalAppRating').innerText = app.rating;
            document.getElementById('modalVoteCount').innerText = app.upvotes;
            document.getElementById('modalVisitLink').href = app.url;

            const featuresList = document.getElementById('modalAppFeatures');
            featuresList.innerHTML = '';
            app.features.forEach(f => {
                const li = document.createElement('li');
                li.className = 'flex items-center gap-2 text-slate-300';
                li.innerHTML = `<i class="fa-solid fa-check text-emerald-400"></i> ${f}`;
                featuresList.appendChild(li);
            });

            document.getElementById('appModal').classList.remove('hidden');
        }

        function closeAppModal() {
            document.getElementById('appModal').classList.add('hidden');
        }

        function addSimulatedComment() {
            const input = document.getElementById('newCommentInput');
            const text = input.value.trim();
            if (!text) return;

            const container = document.getElementById('modalCommentsList');
            const div = document.createElement('div');
            div.className = 'p-3 rounded-lg bg-slate-900/50 border border-slate-800/80';
            div.innerHTML = `
                <div class="flex items-center justify-between text-[10px] text-slate-400 mb-1">
                    <span class="font-semibold text-brand-400">You (Visitor)</span>
                    <span>Just now</span>
                </div>
                <p class="text-[11px] text-slate-300">${text}</p>
            `;
            container.prepend(div);
            input.value = '';
            showToast('Comment published!');
        }

        // Submit modal
        function openSubmitModal() {
            document.getElementById('submitModal').classList.remove('hidden');
        }
        function closeSubmitModal() {
            document.getElementById('submitModal').classList.add('hidden');
        }
        function handleAppSubmission(e) {
            e.preventDefault();
            closeSubmitModal();
            showToast('🎉 Application submitted for review!');
        }

        // Saved Apps Modal
        function openSavedAppsModal() {
            const container = document.getElementById('savedListContainer');
            container.innerHTML = '';

            if (savedAppIds.length === 0) {
                container.innerHTML = '<p class="text-slate-400 text-center py-4">No saved apps yet. Click the bookmark icon on any card to save it.</p>';
            } else {
                savedAppIds.forEach(id => {
                    const app = APPS_DATA.find(a => a.id === id);
                    if (app) {
                        const div = document.createElement('div');
                        div.className = 'flex items-center justify-between p-2.5 rounded-xl bg-slate-900/80 border border-slate-800';
                        div.innerHTML = `
                            <div class="flex items-center gap-3">
                                <img src="${app.logo}" class="w-8 h-8 rounded-lg object-cover">
                                <div>
                                    <h4 class="font-bold text-white text-xs">${app.name}</h4>
                                    <span class="text-[10px] text-slate-400">${app.category_name}</span>
                                </div>
                            </div>
                            <button onclick="openAppModal(${app.id}); closeSavedModal();" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-[10px] font-bold">View</button>
                        `;
                        container.appendChild(div);
                    }
                });
            }

            document.getElementById('savedModal').classList.remove('hidden');
        }

        function closeSavedModal() {
            document.getElementById('savedModal').classList.add('hidden');
        }

        // Toast alert
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function simulatedLoadMore() {
            showToast('Loaded 12 additional apps from directory');
        }

        function subscribeNewsletter(e) {
            e.preventDefault();
            document.getElementById('newsletterSuccess').classList.remove('hidden');
            showToast('Subscribed to weekly digest!');
        }

        // Theme toggle
        let isDark = true;
        function toggleTheme() {
            isDark = !isDark;
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            if (!isDark) {
                html.classList.remove('dark');
                document.body.classList.replace('bg-darkbg', 'bg-slate-50');
                document.body.classList.replace('text-slate-100', 'text-slate-900');
                icon.classList.replace('fa-moon', 'fa-sun');
            } else {
                html.classList.add('dark');
                document.body.classList.replace('bg-slate-50', 'bg-darkbg');
                document.body.classList.replace('text-slate-900', 'text-slate-100');
                icon.classList.replace('fa-sun', 'fa-moon');
            }
        }
    </script>
</body>
</html>
