<!doctype html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AppVault — Next-Gen Software & AI App Directory</title>
    <meta name="description" content="Discover, explore, and upvote the finest modern software applications, AI tools, developer utilities, and productivity platforms.">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            400: '#818cf8',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        },
                        darkbg: '#090D16',
                        darkcard: '#111726',
                        darkborder: '#1E293B',
                    },
                    animation: {
                        'pulse-glow': 'pulseGlow 3s infinite alternate',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        pulseGlow: {
                            '0%': { opacity: '0.4', filter: 'drop-shadow(0 0 15px rgba(99, 102, 241, 0.4))' },
                            '100%': { opacity: '0.8', filter: 'drop-shadow(0 0 30px rgba(168, 85, 247, 0.6))' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-8px)' },
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Custom scrollbar and glassmorphism utilities */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090D16;
        }
        ::-webkit-scrollbar-thumb {
            background: #1E293B;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #334155;
        }
        .glass-panel {
            background: rgba(17, 23, 38, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-panel-light {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
        .gradient-text {
            background: linear-gradient(135deg, #818CF8 0%, #C084FC 50%, #38BDF8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gradient-bg {
            background: linear-gradient(135deg, #4F46E5 0%, #9333EA 50%, #0284C7 100%);
        }
        .gradient-glow {
            box-shadow: 0 0 25px -5px rgba(99, 102, 241, 0.4);
        }
    </style>

    {{ craft.vite.script("src/frontend/js/site.js", false) }}
</head>
<body class="bg-darkbg text-slate-100 font-sans antialiased min-h-screen selection:bg-brand-500 selection:text-white transition-colors duration-300">

    {# ==================== TWIG DATA GENERATION ON THE FLY ==================== #}
    {% set categories = [
        { id: 'all', name: 'All Apps', icon: 'fa-cubes', count: 24 },
        { id: 'ai', name: 'AI & Machine Learning', icon: 'fa-robot', count: 7 },
        { id: 'productivity', name: 'Productivity', icon: 'fa-bolt', count: 5 },
        { id: 'design', name: 'Design & Creative', icon: 'fa-wand-magic-sparkles', count: 4 },
        { id: 'developer', name: 'Developer Tools', icon: 'fa-code', count: 4 },
        { id: 'analytics', name: 'Analytics & Data', icon: 'fa-chart-pie', count: 2 },
        { id: 'security', name: 'Security & Privacy', icon: 'fa-shield-halved', count: 2 }
    ] %}

    {% set category_names = {
        'ai': 'AI & Machine Learning',
        'productivity': 'Productivity',
        'design': 'Design & Creative',
        'developer': 'Developer Tools',
        'analytics': 'Analytics & Data',
        'security': 'Security & Privacy'
    } %}

    {% set price_types = ['Free', 'Freemium', 'Paid', 'Open Source'] %}
    {% set badges_pool = ['🔥 Hot', '✨ New', '⚡ Featured', '🏆 Staff Pick', ''] %}
    {% set suffix_pool = ['AI', 'Studio', 'Flow', 'HQ', 'Lab', 'Pulse', 'Craft', 'Sync', 'OS', 'Grid', 'Desk', 'Vault'] %}

    {# Pre-generate 24 dynamic apps using faker and lorempicsum #}
    {% set apps = [] %}
    {% for i in 1..24 %}
        {% set cat_key = faker.randomElement(['ai', 'productivity', 'design', 'developer', 'analytics', 'security']) %}
        {% set app_name = faker.company ~ ' ' ~ faker.randomElement(suffix_pool) %}
        {% set app_item = {
            'id': i,
            'name': app_name,
            'tagline': faker.catchPhrase,
            'description': faker.text(140),
            'long_description': faker.paragraphs(2, true),
            'category_key': cat_key,
            'category_name': attribute(category_names, cat_key),
            'logo': lorempicsum.square(120, { seed: 'applogo-' ~ i }),
            'screenshot': lorempicsum.image(720, 420, { seed: 'appshot-' ~ i }),
            'rating': faker.randomFloat(1, 4, 5),
            'reviews_count': faker.numberBetween(18, 540),
            'upvotes': faker.numberBetween(140, 3850),
            'pricing': faker.randomElement(price_types),
            'badge': faker.randomElement(badges_pool),
            'url': faker.url,
            'maker_name': faker.name,
            'maker_avatar': lorempicsum.square(80, { seed: 'maker-' ~ i }),
            'maker_title': faker.jobTitle,
            'features': [
                faker.sentence(6),
                faker.sentence(7),
                faker.sentence(5),
                faker.sentence(8)
            ]
        } %}
        {% set apps = apps|merge([app_item]) %}
    {% endfor %}

    {# Spotlight Hero App #}
    {% set spotlight_app = {
        'name': faker.company ~ ' Studio Pro AI',
        'tagline': 'Next-generation automated AI workspace for modern engineering teams',
        'description': faker.text(180),
        'long_description': faker.paragraphs(2, true),
        'category': 'AI & Machine Learning',
        'logo': lorempicsum.square(140, { seed: 'spotlight-logo-main' }),
        'screenshot': lorempicsum.image(960, 520, { seed: 'spotlight-banner-main' }),
        'rating': 4.9,
        'reviews_count': 842,
        'upvotes': 4920,
        'pricing': 'Freemium',
        'url': faker.url,
        'maker_name': faker.name,
        'maker_avatar': lorempicsum.square(90, { seed: 'spotlight-maker-avatar' }),
        'maker_title': 'Founder & CEO',
        'features': [
            faker.sentence(7),
            faker.sentence(8),
            faker.sentence(6)
        ]
    } %}

    {# Pre-generate 4 Collections #}
    {% set collections = [
        {
            'id': 1,
            'title': 'Best AI Coding Assistants in 2026',
            'desc': 'Boost your development velocity with generative AI copilots and auto-refactoring tools.',
            'count': '8 Apps',
            'image': lorempicsum.image(500, 280, { seed: 'collection-1' })
        },
        {
            'id': 2,
            'title': 'Minimalist Workspace & Productivity Stack',
            'desc': 'Curated distraction-free markdown editors, focus timers, and task managers.',
            'count': '6 Apps',
            'image': lorempicsum.image(500, 280, { seed: 'collection-2' })
        },
        {
            'id': 3,
            'title': 'Top Open Source UI Kits & Design Tokens',
            'desc': 'Accelerate web design workflows with accessible component libraries and asset generators.',
            'count': '12 Apps',
            'image': lorempicsum.image(500, 280, { seed: 'collection-3' })
        },
        {
            'id': 4,
            'title': 'Privacy-First Analytics & Data Vaults',
            'desc': 'Cookieless web analytics and end-to-end encrypted telemetry platforms.',
            'count': '5 Apps',
            'image': lorempicsum.image(500, 280, { seed: 'collection-4' })
        }
    ] %}

    {# Pre-generate 3 Testimonials #}
    {% set testimonials = [] %}
    {% for i in 1..3 %}
        {% set test_item = {
            'name': faker.name,
            'title': faker.jobTitle,
            'company': faker.company,
            'avatar': lorempicsum.square(100, { seed: 'testimonial-avatar-' ~ i }),
            'quote': faker.text(140)
        } %}
        {% set testimonials = testimonials|merge([test_item]) %}
    {% endfor %}

    <!-- TOP ANNOUNCEMENT BANNER -->
    <div class="bg-gradient-to-r from-brand-700 via-purple-700 to-indigo-800 text-white text-xs font-semibold py-2 px-4 text-center tracking-wide flex items-center justify-center gap-2">
        <span class="bg-white/20 text-white px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase">Live Directory</span>
        <span>✨ Over {{ faker.numberBetween(1800, 3500) }} modern software &amp; AI tools listed. {{ faker.numberBetween(35, 120) }} new tools added today!</span>
        <a href="#explore-apps" class="underline underline-offset-2 hover:text-indigo-200 ml-1 font-bold">Explore Apps &rarr;</a>
    </div>

    <!-- MAIN NAVBAR -->
    <header class="sticky top-0 z-40 glass-panel border-b border-slate-800/80 transition-all duration-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            
            <!-- Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-11 h-11 rounded-xl gradient-bg flex items-center justify-center text-white text-xl font-black shadow-lg shadow-indigo-500/25 group-hover:scale-105 transition-transform duration-200">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div>
                    <span class="text-xl font-extrabold tracking-tight text-white flex items-center gap-1.5">
                        App<span class="gradient-text">Vault</span>
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    </span>
                    <span class="text-[11px] font-medium text-slate-400 block -mt-1 tracking-wider uppercase">Next-Gen App Directory</span>
                </div>
            </a>

            <!-- Search Bar in Header -->
            <div class="hidden md:flex flex-1 max-w-md mx-6 relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input 
                    type="text" 
                    id="headerSearchInput" 
                    placeholder="Search {{ apps|length }} apps by name, tag, or category..." 
                    class="w-full bg-slate-900/90 text-sm text-slate-200 placeholder-slate-400 pl-10 pr-12 py-2.5 rounded-xl border border-slate-700/70 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition-all"
                    oninput="syncAndFilter(this.value)"
                >
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded border border-slate-700 font-mono">⌘K</span>
            </div>

            <!-- Header Right Controls -->
            <div class="flex items-center gap-3">
                <button onclick="toggleTheme()" class="w-10 h-10 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 flex items-center justify-center border border-slate-700/60 transition-colors" title="Toggle Theme">
                    <i id="themeIcon" class="fa-solid fa-moon text-sm"></i>
                </button>

                <button onclick="openSavedAppsModal()" class="relative hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 text-sm font-medium border border-slate-700/60 transition-colors">
                    <i class="fa-solid fa-bookmark text-amber-400"></i>
                    <span>Saved</span>
                    <span id="savedCountBadge" class="bg-brand-600 text-white text-[10px] font-bold px-1.5 py-0.2 rounded-full hidden">0</span>
                </button>

                <button onclick="openSubmitModal()" class="gradient-bg hover:opacity-95 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-lg shadow-brand-500/20 flex items-center gap-2 transition-all hover:shadow-brand-500/40 active:scale-95">
                    <i class="fa-solid fa-plus text-xs"></i>
                    <span>Submit App</span>
                </button>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="relative overflow-hidden pt-12 pb-16 lg:pt-20 lg:pb-24">
        <!-- Ambient background glows -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-brand-600/15 blur-[120px] rounded-full pointer-events-none"></div>
        <div class="absolute top-1/3 right-10 w-[400px] h-[300px] bg-purple-600/10 blur-[100px] rounded-full pointer-events-none"></div>
        
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-800/80 border border-slate-700/80 text-slate-300 text-xs font-medium mb-6 backdrop-blur-md">
                <span class="flex h-2 w-2 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span>Curated Directory of Independent &amp; Enterprise Software</span>
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-[1.15]">
                Discover the Next Generation of <span class="gradient-text">Apps &amp; AI Tools</span>
            </h1>
            
            <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
                Explore handpicked tools, upvote product launches, and find the perfect software stack to power your next project.
            </p>

            <!-- HERO SEARCH & FILTER BOX -->
            <div class="mt-10 max-w-3xl mx-auto">
                <div class="p-2 rounded-2xl glass-panel border border-slate-700/80 shadow-2xl shadow-slate-950/50 flex flex-col sm:flex-row items-center gap-2">
                    
                    <div class="relative flex-1 w-full">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-base"></i>
                        <input 
                            type="text" 
                            id="heroSearchInput" 
                            placeholder="Search apps by keyword, tag, or stack (e.g. AI, Figma, Code)..." 
                            class="w-full bg-transparent text-white text-base placeholder-slate-400 pl-11 pr-4 py-3.5 rounded-xl focus:outline-none"
                            oninput="syncAndFilter(this.value)"
                        >
                    </div>

                    <div class="flex items-center gap-2 w-full sm:w-auto px-2">
                        <select id="pricingFilter" onchange="filterApps()" class="bg-slate-800 text-slate-200 text-xs font-semibold px-3 py-3 rounded-xl border border-slate-700 focus:outline-none cursor-pointer">
                            <option value="all">All Prices</option>
                            <option value="Free">Free</option>
                            <option value="Freemium">Freemium</option>
                            <option value="Paid">Paid</option>
                            <option value="Open Source">Open Source</option>
                        </select>

                        <button onclick="clearSearch()" class="px-4 py-3 bg-brand-600 hover:bg-brand-500 text-white font-semibold text-sm rounded-xl transition-colors whitespace-nowrap">
                            Search
                        </button>
                    </div>
                </div>

                <!-- Tag Pills -->
                <div class="flex flex-wrap items-center justify-center gap-2 mt-4 text-xs">
                    <span class="text-slate-400 font-medium">Trending searches:</span>
                    <button onclick="setSearchTag('AI')" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition-colors">#AI</button>
                    <button onclick="setSearchTag('Productivity')" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition-colors">#Productivity</button>
                    <button onclick="setSearchTag('Developer')" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition-colors">#Developer</button>
                    <button onclick="setSearchTag('Design')" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition-colors">#Design</button>
                    <button onclick="setSearchTag('Security')" class="px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition-colors">#Security</button>
                </div>
            </div>

        </div>
    </section>

    <!-- SPOTLIGHT / APP OF THE DAY HERO CARD -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
        <div class="relative rounded-3xl overflow-hidden glass-panel border border-brand-500/30 p-6 sm:p-8 lg:p-10 shadow-2xl shadow-indigo-950/40">
            <!-- Top badge -->
            <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold border border-amber-500/30 flex items-center gap-1.5">
                        <i class="fa-solid fa-crown text-amber-400"></i> App of the Day
                    </span>
                    <span class="px-3 py-1 rounded-full bg-brand-500/20 text-brand-300 text-xs font-semibold border border-brand-500/30">
                        {{ spotlight_app.category }}
                    </span>
                    <span class="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold">
                        {{ spotlight_app.pricing }}
                    </span>
                </div>
                <div class="text-xs text-slate-400 flex items-center gap-1">
                    <i class="fa-solid fa-star text-amber-400"></i>
                    <span class="font-bold text-slate-200">{{ spotlight_app.rating }}</span>
                    <span>({{ spotlight_app.reviews_count }} reviews)</span>
                </div>
            </div>

            <!-- Spotlight Content Grid -->
            <div class="grid lg:grid-cols-12 gap-8 items-center">
                <!-- Left Details -->
                <div class="lg:col-span-7 space-y-5">
                    <div class="flex items-start gap-4">
                        <img src="{{ spotlight_app.logo }}" alt="{{ spotlight_app.name }}" class="w-20 h-20 rounded-2xl object-cover border-2 border-slate-700/80 shadow-lg flex-shrink-0">
                        <div>
                            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">{{ spotlight_app.name }}</h2>
                            <p class="text-brand-400 font-medium text-sm mt-0.5">{{ spotlight_app.tagline }}</p>
                        </div>
                    </div>

                    <p class="text-slate-300 text-sm leading-relaxed">
                        {{ spotlight_app.description }}
                    </p>

                    <!-- Key bullet highlights -->
                    <div class="space-y-2 py-1">
                        {% for feat in spotlight_app.features %}
                        <div class="flex items-center gap-2.5 text-xs text-slate-300">
                            <div class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px]">
                                <i class="fa-solid fa-check"></i>
                            </div>
                            <span>{{ feat }}</span>
                        </div>
                        {% endfor %}
                    </div>

                    <!-- Actions -->
                    <div class="flex flex-wrap items-center gap-4 pt-2">
                        <button onclick="upvoteSpotlight(this)" data-votes="{{ spotlight_app.upvotes }}" class="px-5 py-3 rounded-xl gradient-bg hover:opacity-95 text-white font-bold text-sm flex items-center gap-2.5 shadow-lg shadow-brand-500/30 transition-all">
                            <i class="fa-solid fa-caret-up text-base"></i>
                            <span>UPVOTE</span>
                            <span class="bg-white/20 px-2 py-0.5 rounded-md text-xs" id="spotlightVoteCount">{{ spotlight_app.upvotes }}</span>
                        </button>

                        <a href="{{ spotlight_app.url }}" target="_blank" rel="noopener" class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm border border-slate-700 flex items-center gap-2 transition-colors">
                            <span>Visit Website</span>
                            <i class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-400"></i>
                        </a>

                        <!-- Founder avatar snippet -->
                        <div class="flex items-center gap-2.5 ml-auto sm:ml-0 pt-2 sm:pt-0">
                            <img src="{{ spotlight_app.maker_avatar }}" alt="{{ spotlight_app.maker_name }}" class="w-8 h-8 rounded-full border border-slate-600 object-cover">
                            <div class="text-xs">
                                <span class="text-slate-400 block text-[10px]">CREATED BY</span>
                                <span class="text-slate-200 font-semibold">{{ spotlight_app.maker_name }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Screenshot Banner -->
                <div class="lg:col-span-5 relative group">
                    <div class="relative rounded-2xl overflow-hidden border border-slate-700/80 shadow-2xl">
                        <img src="{{ spotlight_app.screenshot }}" alt="App Screenshot" class="w-full h-64 sm:h-72 lg:h-80 object-cover group-hover:scale-105 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                        <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs text-slate-300">
                            <span class="bg-slate-900/80 backdrop-blur-md px-3 py-1 rounded-lg border border-slate-700">Live Preview Interactive</span>
                            <span class="text-emerald-400 font-medium"><i class="fa-solid fa-circle text-[8px] mr-1"></i> Online &amp; Verified</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- EXPLORE APPS SECTION WITH FILTERS -->
    <section id="explore-apps" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20 scroll-mt-24">
        
        <!-- Category Tabs Bar -->
        <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-8 flex-wrap gap-4">
            <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none max-w-full">
                {% for cat in categories %}
                <button 
                    onclick="selectCategory('{{ cat.id }}')" 
                    id="cat-tab-{{ cat.id }}" 
                    class="cat-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold flex items-center gap-2 whitespace-nowrap transition-all border border-transparent {{ loop.first ? 'bg-brand-600 text-white shadow-lg shadow-brand-600/30' : 'bg-slate-800/60 hover:bg-slate-800 text-slate-300 border-slate-800' }}"
                >
                    <i class="fa-solid {{ cat.icon }} text-xs"></i>
                    <span>{{ cat.name }}</span>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] {{ loop.first ? 'bg-white/20 text-white' : 'bg-slate-700 text-slate-400' }}">{{ cat.count }}</span>
                </button>
                {% endfor %}
            </div>

            <!-- Sorting selector -->
            <div class="flex items-center gap-2 ml-auto">
                <span class="text-xs text-slate-400 font-medium hidden sm:inline">Sort by:</span>
                <select id="sortSelect" onchange="sortApps()" class="bg-slate-800 text-slate-200 text-xs font-semibold px-3 py-2 rounded-xl border border-slate-700 focus:outline-none cursor-pointer">
                    <option value="upvotes">Highest Upvoted</option>
                    <option value="rating">Highest Rated</option>
                    <option value="name">Alphabetical</option>
                    <option value="id">Recently Added</option>
                </select>
            </div>
        </div>

        <!-- APP CARDS GRID -->
        <div id="appsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for app in apps %}
            <div 
                class="app-card glass-panel rounded-2xl p-6 border border-slate-800/80 hover:border-slate-700 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-indigo-950/30 flex flex-col justify-between"
                data-id="{{ app.id }}"
                data-name="{{ app.name|e('html_attr') }}"
                data-category="{{ app.category_key }}"
                data-pricing="{{ app.pricing }}"
                data-upvotes="{{ app.upvotes }}"
                data-rating="{{ app.rating }}"
            >
                <div>
                    <!-- Top card header: Logo, Title, Badge -->
                    <div class="flex items-start justify-between gap-3 mb-4">
                        <div class="flex items-center gap-3">
                            <img src="{{ app.logo }}" alt="{{ app.name }}" class="w-14 h-14 rounded-xl object-cover border border-slate-700/80 shadow-md">
                            <div>
                                <h3 class="text-base font-bold text-white leading-snug hover:text-brand-400 transition-colors cursor-pointer" onclick="openAppModal({{ app.id }})">
                                    {{ app.name }}
                                </h3>
                                <span class="text-xs text-slate-400 block mt-0.5">{{ app.category_name }}</span>
                            </div>
                        </div>

                        {% if app.badge %}
                        <span class="px-2.5 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30 text-[10px] font-bold whitespace-nowrap">
                            {{ app.badge }}
                        </span>
                        {% endif %}
                    </div>

                    <!-- Tagline & Description -->
                    <p class="text-xs font-semibold text-brand-400 mb-2 line-clamp-1">{{ app.tagline }}</p>
                    <p class="text-slate-300 text-xs leading-relaxed mb-4 line-clamp-2">
                        {{ app.description }}
                    </p>

                    <!-- Meta Pill Row -->
                    <div class="flex items-center justify-between text-[11px] text-slate-400 mb-4 pt-2 border-t border-slate-800/60">
                        <span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-300 font-medium">
                            {{ app.pricing }}
                        </span>
                        <div class="flex items-center gap-1 text-amber-400 font-bold">
                            <i class="fa-solid fa-star text-[10px]"></i>
                            <span>{{ app.rating }}</span>
                            <span class="text-slate-500 font-normal">({{ app.reviews_count }})</span>
                        </div>
                    </div>
                </div>

                <!-- Footer Card Action Row -->
                <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-800/40">
                    <button 
                        onclick="toggleBookmark({{ app.id }}, this)" 
                        class="w-9 h-9 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-400 hover:text-amber-400 flex items-center justify-center border border-slate-700/60 transition-colors" 
                        title="Bookmark App"
                    >
                        <i class="fa-regular fa-bookmark text-xs"></i>
                    </button>

                    <button 
                        onclick="openAppModal({{ app.id }})" 
                        class="flex-1 py-2 px-3 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700/60 transition-colors text-center"
                    >
                        Details
                    </button>

                    <button 
                        onclick="upvoteApp({{ app.id }}, this)" 
                        class="upvote-btn px-3 py-2 rounded-lg bg-slate-800 hover:bg-brand-600 text-slate-200 hover:text-white text-xs font-bold flex items-center gap-1.5 border border-slate-700 hover:border-brand-500 transition-all"
                    >
                        <i class="fa-solid fa-caret-up text-sm"></i>
                        <span class="vote-count">{{ app.upvotes }}</span>
                    </button>
                </div>
            </div>
            {% endfor %}
        </div>

        <!-- Empty state fallback -->
        <div id="noResultsState" class="hidden text-center py-16 glass-panel rounded-2xl my-8">
            <i class="fa-solid fa-magnifying-glass text-4xl text-slate-600 mb-4"></i>
            <h3 class="text-lg font-bold text-white">No applications found</h3>
            <p class="text-slate-400 text-sm mt-1 max-w-md mx-auto">We couldn't find any tools matching your search criteria. Try adjusting filters or search term.</p>
            <button onclick="clearSearch()" class="mt-4 px-4 py-2 bg-brand-600 text-white rounded-xl text-xs font-bold">Clear All Filters</button>
        </div>

        <!-- Load More Button -->
        <div class="mt-12 text-center">
            <button id="loadMoreBtn" onclick="simulatedLoadMore()" class="px-6 py-3 rounded-xl glass-panel hover:bg-slate-800 text-slate-300 font-semibold text-sm border border-slate-700 transition-all">
                <span>Show More Applications</span>
                <i class="fa-solid fa-chevron-down text-xs ml-2"></i>
            </button>
        </div>
    </section>

